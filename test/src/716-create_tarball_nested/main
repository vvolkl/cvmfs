#!/bin/bash

cvmfs_test_name="Create tarball across nested catalogs"
cvmfs_test_autofs_on_startup=false
cvmfs_test_suites="quick"

cvmfs_run_test() {
  logfile=$1
  local scratch_dir=$(pwd)
  local repo_dir="/cvmfs/${CVMFS_TEST_REPO}"
  local subtree="exports/root"
  local tarball="${scratch_dir}/create-tarball.tar"
  local reference_tar="${scratch_dir}/mounted.tar"
  local extracted_dir="${scratch_dir}/extracted"
  local reference_dir="${scratch_dir}/reference"

  echo "*** create a fresh repository named $CVMFS_TEST_REPO"
  create_empty_repo $CVMFS_TEST_REPO $CVMFS_TEST_USER NO -g -z || return $?
  load_repo_config $CVMFS_TEST_REPO || return 10

  echo "*** force small file chunks so the export exercises the chunked path"
  sudo tee -a /etc/cvmfs/repositories.d/${CVMFS_TEST_REPO}/server.conf >/dev/null <<EOF || return 9
CVMFS_USE_FILE_CHUNKING=true
CVMFS_MIN_CHUNK_SIZE=1048576
CVMFS_AVG_CHUNK_SIZE=2097152
CVMFS_MAX_CHUNK_SIZE=4194304
EOF
  load_repo_config $CVMFS_TEST_REPO || return 10

  echo "*** create an export subtree that crosses a nested catalog"
  start_transaction $CVMFS_TEST_REPO || return $?
  mkdir -p "${repo_dir}/${subtree}/nested/leaf"                     || return 11
  printf 'alpha\n' > "${repo_dir}/${subtree}/alpha.txt"             || return 12
  printf 'inner payload\n' > "${repo_dir}/${subtree}/nested/inner.txt" || return 13
  printf 'nested payload\n' > "${repo_dir}/${subtree}/nested/leaf/file.txt"   || return 14
  touch "${repo_dir}/${subtree}/nested/.cvmfscatalog"               || return 15
  # A file larger than the in-memory small-file threshold (256 KiB) but smaller
  # than the minimum chunk size exercises the single-object temp-file path.
  head -c 524288 /dev/urandom > "${repo_dir}/${subtree}/large.bin"  || return 16
  # A file larger than the maximum chunk size is split into several chunks,
  # exercising the multi-chunk parallel fetch and assembly path.
  head -c $((10 * 1024 * 1024)) /dev/urandom \
    > "${repo_dir}/${subtree}/big_chunked.bin"                      || return 18
  publish_repo $CVMFS_TEST_REPO || return $?

  echo "*** confirm the large file was actually chunked"
  local rdonly="/var/spool/cvmfs/${CVMFS_TEST_REPO}/rdonly"
  local nchunks=$(attr -qg chunks "${rdonly}/${subtree}/big_chunked.bin")
  [ "x$nchunks" != "x" ] && [ "$nchunks" -gt 1 ] || return 17

  echo "*** export the subtree through cvmfs_server create-tarball"
  # swissknife runs as $CVMFS_TEST_USER; grant access to scratch_dir
  chmod -R a+rX "$scratch_dir"                                      || return 23
  chmod a+rwx "$scratch_dir"                                        || return 23
  cvmfs_server create-tarball -p "/${subtree}" -o "$tarball" $CVMFS_TEST_REPO || return 24
  tar tf "$tarball" | LC_ALL=C sort > create-tarball.list          || return 27
  # The tarball should contain the contents of the subtree directory at the
  # top level (no parent directory prefix), matching container layer layout.
  tar -C "${repo_dir}/${subtree}"                                   \
    --exclude='.cvmfscatalog'                                       \
    --exclude='.cvmfsautocatalog'                                   \
    -cf "$reference_tar" .                                          || return 28
  tar tf "$reference_tar" | sed 's|^\./||' | sed '/^$/d' | LC_ALL=C sort > mounted.list || return 29
  diff -u mounted.list create-tarball.list                           || return 30
  ! grep -q '\.cvmfscatalog$' create-tarball.list                   || return 31

  echo "*** extract the tarballs and compare them with the mounted subtree"
  mkdir -p "$extracted_dir" "$reference_dir"                      || return 32
  tar -C "$extracted_dir" -xf "$tarball"                          || return 33
  tar -C "$reference_dir" -xf "$reference_tar"                   || return 34
  compare_directories "$extracted_dir" "$reference_dir"              || return 35

  # The cvmfs_server wrapper drives swissknife against CVMFS_STRATUM0, i.e. the
  # HTTP fetch path. Invoke swissknife directly against the local backend store
  # to also exercise the local fetcher (in-memory decompress, single-object and
  # chunked temp files). The output must be identical to the HTTP export.
  echo "*** export the same subtree directly from local storage"
  local local_storage="$(get_local_repo_storage $CVMFS_TEST_REPO)"
  local local_tarball="${scratch_dir}/create-tarball-local.tar"
  local extracted_local_dir="${scratch_dir}/extracted-local"
  cvmfs_swissknife create-tarball -r "$local_storage" -p "/${subtree}" \
    -o "$local_tarball" -l "$scratch_dir"                           || return 40
  tar tf "$local_tarball" | LC_ALL=C sort > create-tarball-local.list || return 41
  diff -u create-tarball.list create-tarball-local.list             || return 42
  mkdir -p "$extracted_local_dir"                                  || return 43
  tar -C "$extracted_local_dir" -xf "$local_tarball"              || return 44
  compare_directories "$extracted_local_dir" "$reference_dir"       || return 45

  echo "*** check catalog and data integrity"
  check_repository $CVMFS_TEST_REPO -i || return $?
  return 0
}
